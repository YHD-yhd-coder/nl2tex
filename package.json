{
  "name": "nl2tex",
  "version": "0.4.0",
  "description": "把中文/英文的自然语言描述转成可编译的 LaTeX 公式，并做 KaTeX 编译校验",
  "type": "module",
  "license": "MIT",
  "main": "src/core.mjs",
  "bin": {
    "nl2tex": "cli.mjs"
  },
  "files": [
    "src",
    "public",
    "server.mjs",
    "cli.mjs",
    "start.cmd",
    "start.sh",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node server.mjs",
    "cli": "node cli.mjs",
    "test": "node test/run.mjs",
    "test:ocr": "node test/ocr.mjs",
    "bench": "node bench.mjs",
    "demo": "node scripts/demo-gif.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "katex": "^0.16.11",
    "mathml2omml": "^0.5.0"
  },
  "devDependencies": {
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.18.1"
  }
}
